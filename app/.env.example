# FinChaya app settings.
# Copy this file to ".env" next to api.py and fill in real values.
# NEVER commit ".env": it holds database and API credentials.
#
# Lines starting with "#" are optional. Leave them commented out to use the
# built-in default -- an optional setting that is present but EMPTY is read as
# an empty string, not as "use the default", and some of them are parsed as
# numbers, which would crash on an empty value.

# ---------------------------------------------------------------------------
# Database (required by the API and every script in this folder)
# ---------------------------------------------------------------------------
# Postgres connection string. Some scripts also accept DATABASE_URL or MF_DSN
# as fallbacks.
FINCHAYA_DB=

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# "production" on the live server; anything else is treated as development.
MF_ENV=dev

# Paywall gating. Off unless "true". Only turn it on once sign-in works,
# otherwise the gated data disappears for everyone including you.
MF_PAYWALL_ENABLED=false

# FinChaya scores, ranks and the rising/sideways/falling split. A hard off for
# EVERYONE (subscribers included) unless "true".
MF_SCORES_ENABLED=false

# Comma-separated emails allowed to see the experimental "lab" fund score.
LAB_EMAILS=

# Comma-separated extra origins allowed by CORS. Leave empty when the pages are
# served by this same app (the normal case).
MF_CORS_ORIGINS=

MF_SESSION_DAYS=90
MF_OTP_TTL_MIN=10

# ---------------------------------------------------------------------------
# Sign-in and email
# ---------------------------------------------------------------------------
# Google Sign-In client ID. A public identifier, not a secret. Do NOT put the
# client secret here; this flow does not use it.
MF_GOOGLE_CLIENT_ID=

# Outgoing mail (sign-in codes and notices).
MF_SMTP_HOST=smtp.gmail.com
MF_SMTP_PORT=587
MF_SMTP_USER=
MF_SMTP_PASS=
# MF_MAIL_FROM=

# DEVELOPMENT ONLY: a fixed sign-in code accepted for the listed emails.
# The API refuses to start if MF_AUTH_DEV_OTP is set while MF_ENV=production.
# MF_AUTH_DEV_OTP=
# MF_AUTH_DEV_EMAILS=

# ---------------------------------------------------------------------------
# Zerodha / Kite (market-data pipeline: fetch_technicals.py,
# zerodha_login_with_auto.py, monthly.sh)
# ---------------------------------------------------------------------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
# TOTP secret for automatic 2FA (the key shown when you set up the
# authenticator app). Needed for the unattended nightly login.
ZERODHA_TOTP_SECRET=
# ZERODHA_HEADLESS=

# ---------------------------------------------------------------------------
# Razorpay billing (payments.py). Server side only; use Test-mode keys first.
# The billing routes are mounted only if payments.py can load.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=
# Display text; defaults are "₹149 / month" and "₹999 / year".
# RAZORPAY_PRICE_MONTHLY=
# RAZORPAY_PRICE_YEARLY=
# RAZORPAY_TOTAL_COUNT_MONTHLY=1200
# RAZORPAY_TOTAL_COUNT_YEARLY=99
# RAZORPAY_GRACE_DAYS=3

# ---------------------------------------------------------------------------
# Fyers (broker hand-off). Listed in the original template; not read by any
# script in this folder, so only needed if you wire that integration back in.
# ---------------------------------------------------------------------------
# FYERS_CLIENT_ID=
# FYERS_SECRET_KEY=
# FYERS_REDIRECT_URI=https://127.0.0.1

# ---------------------------------------------------------------------------
# Scoring tunables (optional; shown with their built-in defaults)
# ---------------------------------------------------------------------------
# MF_STOCK_ALGO=stock-v3
# MF_FUND_ALGO=fund-v2
# MF_RISK_FREE=6.5
# MF_ROLLING_HURDLE=12.0

# One-off: password for a CAS statement PDF, if load_cas.py is run without
# --password.
# CAS_PASSWORD=
